# ============================================================
# Ejemplo de variables para el backend en EC2.
# Copia este archivo como .env en /opt/pasarela y completa los valores.
# No subas el .env real a Git.
# ============================================================

# Endpoint de RDS (o db:3306 cuando uses MySQL en Docker).
DB_URL=jdbc:mysql://TU_ENDPOINT_RDS:3306/pasarela_db?sslMode=REQUIRED&serverTimezone=UTC

# Usuario de aplicacion, no el usuario master de RDS.
DB_USER=pasarela
DB_PASSWORD=CAMBIA_ESTA_PASSWORD

# Secreto JWT nuevo, distinto al de desarrollo. Minimo 32 caracteres.
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_MS=36000000

# Temporal: luego agrega la URL exacta del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# t3.micro tiene 1 GB de RAM: heap reducido.
JAVA_TOOL_OPTIONS="-Xms128m -Xmx384m"
